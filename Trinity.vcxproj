  <!-- ============================================
       MySQL: опционально. По умолчанию проект собирается БЕЗ клиентской
       библиотеки MySQL (режим заглушки БД в TrinityCore.cpp) — так .arx
       гарантированно не падает в AutoCAD из-за отсутствующей/битой
       libmysql.dll (delay-load -> SEH 0xC000027D при первом запросе).

       Чтобы включить реальный доступ к базе: скачайте MySQL Connector/C
       8.0.x ZIP (сервер ставить не нужно), распакуйте, например в
       D:\devel\MySQL, и соберите с UseMysql=true:
         msbuild Trinity.vcxproj /p:Configuration=Release /p:Platform=x64 /p:UseMysql=true
       либо задайте переменные MYSQL_INCLUDE_DIR / MYSQL_LIB_DIR.
       После сборки скопируйте libmysql.dll из <Connector>\lib в папку
       с _Trinity.arx (код сам найдёт DLL рядом с модулем).
       ============================================ -->
  <PropertyGroup>
    <UseMysql Condition="'$(UseMysql)'==''">false</UseMysql>
    <MysqlIncludeDir Condition="'$(MysqlIncludeDir)'==''">$(MYSQL_INCLUDE_DIR)</MysqlIncludeDir>
    <MysqlLibDir Condition="'$(MysqlLibDir)'==''">$(MYSQL_LIB_DIR)</MysqlLibDir>
    <MysqlIncludeDir Condition="'$(MysqlIncludeDir)'==''">D:\devel\MySQL\include</MysqlIncludeDir>
    <MysqlLibDir Condition="'$(MysqlLibDir)'==''">D:\devel\MySQL\lib</MysqlLibDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)x64\$(Configuration)\</OutDir>
